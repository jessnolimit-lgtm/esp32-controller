<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml
  ─────────────────
  Layout structure (top → bottom):
    1. App title
    2. Connection status badge
    3. Connect / Disconnect button
    4. D-pad control grid (Forward, Left, STOP, Right, Backward)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- ── App Title ─────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ESP32 Bluetooth Remote"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <!-- ── Status badge ──────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="○ Disconnected"
        android:textSize="15sp"
        android:textColor="@color/status_disconnected"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:textStyle="bold" />

    <!-- ── Connect button ────────────────────────────────────────────── -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Connect Bluetooth"
        android:textSize="15sp"
        android:backgroundTint="@color/accent_blue"
        android:stateListAnimator="@null"
        style="@style/Widget.MaterialComponents.Button" />

    <!-- ── D-pad spacer ──────────────────────────────────────────────── -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── D-pad label ───────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="CONTROLS"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:textColor="@color/text_secondary" />

    <!-- ── Row 1: Forward ────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Spacer left -->
        <View android:layout_width="90dp" android:layout_height="90dp" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="6dp"
            android:text="▲"
            android:textSize="28sp"
            android:backgroundTint="@color/btn_direction"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Spacer right -->
        <View android:layout_width="90dp" android:layout_height="90dp" />
    </LinearLayout>

    <!-- ── Row 2: Left · STOP · Right ────────────────────────────────── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="6dp"
            android:text="◀"
            android:textSize="28sp"
            android:backgroundTint="@color/btn_direction"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="6dp"
            android:text="■"
            android:textSize="28sp"
            android:backgroundTint="@color/btn_stop"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="6dp"
            android:text="▶"
            android:textSize="28sp"
            android:backgroundTint="@color/btn_direction"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

    <!-- ── Row 3: Backward ───────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Spacer left -->
        <View android:layout_width="90dp" android:layout_height="90dp" />

        <Button
            android:id="@+id/btnBackward"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="6dp"
            android:text="▼"
            android:textSize="28sp"
            android:backgroundTint="@color/btn_direction"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Spacer right -->
        <View android:layout_width="90dp" android:layout_height="90dp" />
    </LinearLayout>

    <!-- ── Bottom padding ────────────────────────────────────────────── -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="F · Forward   B · Backward   L · Left   R · Right   S · Stop"
        android:textSize="10sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
