<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml  –  Landscape RC Car Dashboard
  ─────────────────────────────────────────────────
  Three-column layout:
    LEFT  (weight 1.4): Drive controls  (Forward / Stop / Backward)
    CENTER(weight 2.2): Car dashboard   (Speedometer, status, lights, signals, horn)
    RIGHT (weight 1.8): Steering        (Left | Right side-by-side)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_dark"
    android:padding="8dp">

    <!-- ═══════════════════════════════════════
         LEFT — Drive: Forward / STOP / Backward
         ═══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRIVE"
            android:textSize="9sp"
            android:letterSpacing="0.18"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Forward -->
        <ImageView
            android:id="@+id/btnForward"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/ripple_direction_btn"
            android:src="@drawable/ic_arrow_up"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Forward" />

        <!-- STOP -->
        <ImageView
            android:id="@+id/btnStop"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/ripple_stop_btn"
            android:src="@drawable/ic_stop"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Stop" />

        <!-- Backward -->
        <ImageView
            android:id="@+id/btnBackward"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/ripple_direction_btn"
            android:src="@drawable/ic_arrow_down"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Backward" />

        <!-- Hint labels -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ Fwd"
                android:textSize="8sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="■ Stop"
                android:textSize="8sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ Rev"
                android:textSize="8sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>

    <!-- Gap -->
    <View android:layout_width="6dp" android:layout_height="match_parent" />

    <!-- ═══════════════════════════════════════
         CENTER — Dashboard
         ═══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.2"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="10dp"
        android:gravity="center_horizontal">

        <!-- ── Top bar: title + status + connect ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RC CAR"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Disconnected"
                android:textSize="10sp"
                android:textColor="@color/status_disconnected"
                android:background="@drawable/bg_status_pill"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/ripple_accent_btn"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- ── Speedometer ── -->
        <com.example.rccarcontroller.SpeedometerView
            android:id="@+id/speedometerView"
            android:layout_width="130dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal" />

        <!-- Gear label -->
        <TextView
            android:id="@+id/tvGearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IDLE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:letterSpacing="0.1"
            android:layout_marginTop="2dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- ── Indicator arrows + controls row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left blink indicator -->
            <ImageView
                android:id="@+id/indicatorLeft"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_arrow_left_signal"
                android:padding="3dp"
                android:alpha="0.25"
                android:contentDescription="Left Signal" />

            <!-- Controls: Headlights · Hazard · Horn · Left Signal · Right Signal -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Headlights -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp">

                    <ImageView
                        android:id="@+id/btnHeadlights"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_light_indicator"
                        android:src="@drawable/ic_headlight"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Headlights" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEAD"
                        android:textSize="7sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Left Signal -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp">

                    <ImageView
                        android:id="@+id/btnLeftSignal"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_light_indicator"
                        android:src="@drawable/ic_arrow_left_signal"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Left Signal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="L-SIG"
                        android:textSize="7sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Hazard -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp">

                    <ImageView
                        android:id="@+id/btnHazard"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_light_indicator"
                        android:src="@drawable/ic_hazard"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Hazard" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HAZARD"
                        android:textSize="7sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Right Signal -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp">

                    <ImageView
                        android:id="@+id/btnRightSignal"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_light_indicator"
                        android:src="@drawable/ic_arrow_right_signal"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Right Signal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R-SIG"
                        android:textSize="7sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Horn -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp">

                    <ImageView
                        android:id="@+id/btnHorn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_light_indicator"
                        android:src="@drawable/ic_horn"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Horn" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HORN"
                        android:textSize="7sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Right blink indicator -->
            <ImageView
                android:id="@+id/indicatorRight"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_arrow_right_signal"
                android:padding="3dp"
                android:alpha="0.25"
                android:contentDescription="Right Signal" />

        </LinearLayout>

    </LinearLayout>

    <!-- Gap -->
    <View android:layout_width="6dp" android:layout_height="match_parent" />

    <!-- ═══════════════════════════════════════
         RIGHT — Steering: Left | Right side-by-side
         ═══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEER"
            android:textSize="9sp"
            android:letterSpacing="0.18"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Left + Right side by side -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Steer Left -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginRight="10dp">

                <ImageView
                    android:id="@+id/btnLeft"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/ripple_direction_btn"
                    android:src="@drawable/ic_arrow_left"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Steer Left" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀ LEFT"
                    android:textSize="8sp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Steer Right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnRight"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/ripple_direction_btn"
                    android:src="@drawable/ic_arrow_right"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Steer Right" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIGHT ▶"
                    android:textSize="8sp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
